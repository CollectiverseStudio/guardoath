            "\\hh.exe",
            "\\wmic.exe",
            "\\mshta.exe",
            "\\rundll32.exe",
            "\\forfiles.exe",
            "\\scriptrunner.exe",
            "\\mftrace.exe",
            "\\AppVLP.exe",
            "\\systeminfo.exe",
            "\\reg.exe",
            "\\query.exe"
          ]
        },
        "condition": "selection"
      },
      "falsepositives": [
