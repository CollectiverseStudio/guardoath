        "attack.t1185",
        "attack.t1564.003"
      ],
      "logsource": {
        "category": "process_creation",
        "product": "windows"
      },
      "detection": {
        "selection": {
          "CommandLine|contains|all": [
            "--remote-debugging-",
            "--user-data-dir",
            "--headless"
          ]
        },
        "condition": "selection"
      },
      "falsepositives": [
        "Unknown"
      ],
      "level": "high",
      "source_path": "rules/windows/process_creation/proc_creation_win_browsers_chromium_headless_debugging.yml",
      "source_sha256": "6bd0a8b10ef3420d2812d8cf779c6bc280900fbe509afe242f51594fb0dc6eff",
