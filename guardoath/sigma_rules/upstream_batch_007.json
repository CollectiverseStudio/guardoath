      "positive_event": {
        "Image": "C:\\Lab\\chrome.exe",
        "CommandLine": "chrome --remote-debugging-port=9222 --user-data-dir=C:\\Lab\\Browser --headless"
      },
      "negative_event": {
        "Image": "C:\\Lab\\chrome.exe",
        "CommandLine": "chrome --remote-debugging-port=9222 --headless"
      }
    },
