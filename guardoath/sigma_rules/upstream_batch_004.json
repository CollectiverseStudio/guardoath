        "attack.stealth"
      ],
      "logsource": {
        "product": "windows",
        "category": "ps_script",
        "definition": "Script Block Logging must be enable"
      },
      "detection": {
        "selection_cmdlet": {
          "ScriptBlockText|contains": [
            "Add-AppPackage ",
            "Add-AppxPackage "
