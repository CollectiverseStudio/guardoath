      "positive_event": {
        "ScriptBlockText": "Add-AppxPackage C:\\lab.appx -AllowUnsigned"
      },
      "negative_event": {
        "ScriptBlockText": "Add-AppxPackage C:\\lab.appx"
      }
    },
