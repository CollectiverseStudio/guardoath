      "source_git_blob": "241eaa06ab32aa286e86220f0d884bbd04fa7776",
      "positive_event": {
        "ScriptBlockText": "new-object system.io.compression.deflatestream; [text.encoding]::ascii; readtoend"
      },
      "negative_event": {
        "ScriptBlockText": "new-object IO.MemoryStream"
      }
