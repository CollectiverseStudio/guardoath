        "ParentImage": "C:\\Users\\Lab\\AppData\\Local\\Apps\\2.0\\Lab\\dfsvc.exe",
        "Image": "C:\\Windows\\System32\\cmd.exe"
      },
      "negative_event": {
        "ParentImage": "C:\\Trusted\\Apps\\Lab\\dfsvc.exe",
        "Image": "C:\\Windows\\System32\\cmd.exe"
      }
    },
