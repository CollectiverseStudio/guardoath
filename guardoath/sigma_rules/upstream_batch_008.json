        "condition": "selection"
      },
      "falsepositives": [
        "Unknown"
      ],
      "level": "medium",
      "source_path": "rules/windows/process_creation/proc_creation_win_dfsvc_suspicious_child_processes.yml",
      "source_sha256": "76c32a0579f287f8902c62065e545a2b721f4ab1bf5cd7eae80e7539b070c9ff",
