    {
      "title": "Suspicious Processes Spawned by Java.EXE",
      "id": "0d34ed8b-1c12-4ff2-828c-16fc860b766d",
      "related": [
        {
          "id": "dff1e1cc-d3fd-47c8-bfc2-aeb878a754c0",
          "type": "similar"
        }
      ],
      "status": "test",
      "description": "Detects suspicious processes spawned from a Java host process which could indicate a sign of exploitation (e.g. log4j)",
      "references": [
        "https://web.archive.org/web/20231230220738/https://www.lunasec.io/docs/blog/log4j-zero-day/"
      ],
      "author": "Andreas Hunkeler (@Karneades), Florian Roth",
      "date": "2021-12-17",
      "modified": "2024-01-18",
      "tags": [
        "attack.initial-access",
        "attack.persistence",
        "attack.privilege-escalation"
      ],
      "logsource": {
        "category": "process_creation",
        "product": "windows"
      },
      "detection": {
        "selection": {
          "ParentImage|endswith": "\\java.exe",
          "Image|endswith": [
            "\\AppVLP.exe",
            "\\bitsadmin.exe",
            "\\certutil.exe",
            "\\cscript.exe",
            "\\curl.exe",
            "\\forfiles.exe",
            "\\hh.exe",
            "\\mftrace.exe",
            "\\mshta.exe",
            "\\net.exe",
            "\\net1.exe",
            "\\query.exe",
            "\\reg.exe",
            "\\regsvr32.exe",
            "\\rundll32.exe",
            "\\schtasks.exe",
            "\\scrcons.exe",
            "\\scriptrunner.exe",
            "\\sh.exe",
            "\\systeminfo.exe",
            "\\whoami.exe",
            "\\wmic.exe",
            "\\wscript.exe"
          ]
        },
        "condition": "selection"
      },
      "falsepositives": [
        "Legitimate calls to system binaries",
        "Company specific internal usage"
      ],
      "level": "high",
      "source_path": "rules/windows/process_creation/proc_creation_win_java_susp_child_process.yml",
      "source_sha256": "a67427054c323d2dfc3df9fa7f233a945ce9d19a1f38b30ebc3c459a254bea7f",
      "source_git_blob": "22a99af45b992cf6b66e723c39ed147464ba7db1",
      "positive_event": {
        "ParentImage": "C:\\fixtures\\java.exe",
        "Image": "C:\\fixtures\\AppVLP.exe"
      },
      "negative_event": {
        "ParentImage": "C:\\benign\\ordinary.exe",
        "Image": "C:\\benign\\ordinary.exe"
      }
    },
