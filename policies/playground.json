{
  "format_version": "1",
  "policies": [
    {
      "application_id": "demo",
      "version": "conversation-v1",
      "mode": "observe",
      "timeout_ms": 500,
      "failure_action": "block",
      "rules": [
        {
          "checker_id": "pii",
          "required": true,
          "on_finding": "flag",
          "on_output_finding": "block"
        },
        {
          "checker_id": "secrets",
          "required": true,
          "on_finding": "flag",
          "on_output_finding": "block"
        },
        {
          "checker_id": "text_security",
          "required": true,
          "on_finding": "flag",
          "on_output_finding": "block"
        }
      ],
      "detect_secret_assignments": true,
      "inspect_encoded_secrets": true,
      "confidential_terms": [
        {
          "rule_id": "internal_project",
          "term": "PROJECT LANTERN"
        },
        {
          "rule_id": "unreleased_plan",
          "term": "unreleased pricing plan",
          "stages": [
            "output"
          ]
        }
      ],
      "detect_labeled_sensitive_data": true
    },
    {
      "application_id": "demo",
      "version": "pii-v1",
      "mode": "observe",
      "timeout_ms": 500,
      "failure_action": "block",
      "rules": [
        {
          "checker_id": "pii",
          "required": true,
          "on_finding": "flag"
        }
      ]
    },
    {
      "application_id": "demo",
      "version": "business-v1",
      "mode": "observe",
      "rules": [
        {
          "checker_id": "schema",
          "on_finding": "block"
        },
        {
          "checker_id": "cross_field",
          "on_finding": "flag",
          "on_output_finding": "block"
        }
      ],
      "input_schema": {
        "type": "object",
        "required": [
          "start_date",
          "end_date",
          "purchase_amount",
          "refund_amount"
        ],
        "additionalProperties": false,
        "properties": {
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "purchase_amount": {
            "type": "number",
            "minimum": 0
          },
          "refund_amount": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "start_date",
          "end_date",
          "purchase_amount",
          "refund_amount"
        ],
        "additionalProperties": false,
        "properties": {
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "purchase_amount": {
            "type": "number",
            "minimum": 0
          },
          "refund_amount": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "comparisons": [
        {
          "rule_id": "date_order",
          "left": "/start_date",
          "right": "/end_date",
          "operator": "lt",
          "value_type": "date"
        },
        {
          "rule_id": "refund_limit",
          "left": "/refund_amount",
          "right": "/purchase_amount",
          "operator": "le",
          "value_type": "number"
        }
      ]
    },
    {
      "application_id": "demo",
      "version": "redaction-v1",
      "mode": "observe",
      "timeout_ms": 500,
      "failure_action": "block",
      "rules": [
        {
          "checker_id": "pii",
          "required": true,
          "on_finding": "redact"
        }
      ],
      "detect_labeled_sensitive_data": true
    },
    {
