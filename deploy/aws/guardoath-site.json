{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Description": "GuardOath website (guardoath.com): CloudFront flat-rate Free plan + WAF rate rule + Lambda function URL (origin access control) + DynamoDB tenant records, with alarms that stop the site before the free allowances run out. See deploy/aws/README.md.",
 "Parameters": {
  "DomainName": {
   "Type": "String",
   "Default": "guardoath.com",
   "AllowedPattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
  },
  "HostedZoneId": {
   "Type": "String",
   "Default": "Z0746804K5NUDOB3FWPU",
   "AllowedPattern": "^Z[A-Z0-9]{1,32}$"
  },
  "DemoKeySecret": {
   "Type": "String",
   "NoEcho": true,
   "MinLength": 32,
   "MaxLength": 200,
   "Description": "Secret the demo user keys are derived from (GUARDOATH_DEMO_KEY_SECRET). At least 32 characters."
  },
  "TableReadCapacity": {
   "Type": "Number",
   "Default": 10,
   "MinValue": 1,
   "MaxValue": 25,
   "Description": "Provisioned reads. The always-free DynamoDB allowance is 25 read capacity units in total."
  },
  "TableWriteCapacity": {
   "Type": "Number",
   "Default": 10,
   "MinValue": 1,
   "MaxValue": 25,
   "Description": "Provisioned writes. The always-free DynamoDB allowance is 25 write capacity units in total."
  },
  "RequestsPerIpPer5Minutes": {
   "Type": "Number",
   "Default": 300,
   "MinValue": 10,
   "MaxValue": 20000
  },
  "InvocationsPerHourLimit": {
   "Type": "Number",
   "Default": 1300,
   "Description": "Stop the site above this many function invocations in one hour (1,300 x 744 hours < the 1,000,000 free requests a month)."
  },
  "InvocationsPerDayLimit": {
   "Type": "Number",
   "Default": 30000,
   "Description": "Stop the site above this many invocations in one day (30,000 x 31 < 1,000,000)."
  },
  "DurationMsPerHourLimit": {
   "Type": "Number",
   "Default": 900000,
   "Description": "Stop the site above this much function run time (ms) in one hour. 900 s x 744 h x 0.5 GB = 334,800 GB-seconds < the 400,000 free GB-seconds a month."
  }
 },
 "Rules": {
  "UsEast1Only": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Equals": [
       {
        "Ref": "AWS::Region"
       },
       "us-east-1"
      ]
     },
     "AssertDescription": "Deploy in us-east-1: the CloudFront certificate and the CLOUDFRONT-scope web ACL must be there."
    }
   ]
  }
 },
 "Resources": {
  "TenantTable": {
   "Type": "AWS::DynamoDB::Table",
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain",
   "Properties": {
    "TableName": "guardoath-tenants",
    "BillingMode": "PROVISIONED",
    "AttributeDefinitions": [
     {
      "AttributeName": "tenant_id",
      "AttributeType": "S"
     }
    ],
    "KeySchema": [
     {
      "AttributeName": "tenant_id",
      "KeyType": "HASH"
     }
    ],
    "ProvisionedThroughput": {
     "ReadCapacityUnits": {
      "Ref": "TableReadCapacity"
     },
     "WriteCapacityUnits": {
      "Ref": "TableWriteCapacity"
     }
    },
    "DeletionProtectionEnabled": true
   }
  },
  "SiteLogGroup": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": "/aws/lambda/guardoath-site",
    "RetentionInDays": 7
   }
  },
  "ShutoffLogGroup": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": "/aws/lambda/guardoath-site-shutoff",
    "RetentionInDays": 7
   }
  },
  "SiteRole": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "lambda.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "site",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": {
          "Fn::Sub": "${SiteLogGroup.Arn}"
         }
        },
        {
         "Effect": "Allow",
         "Action": [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:Scan"
         ],
         "Resource": {
          "Fn::GetAtt": [
           "TenantTable",
           "Arn"
          ]
         }
        }
       ]
      }
     }
    ]
   }
  },
  "SiteFunction": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "FunctionName": "guardoath-site",
    "Description": "GuardOath website and API",
    "Runtime": "python3.13",
    "Architectures": [
     "x86_64"
    ],
    "Handler": "index.handler",
    "Code": {
     "ZipFile": "import json\ndef handler(event, context):\n    # Replaced by the real package: aws lambda update-function-code (see deploy/aws/README.md).\n    return {\"statusCode\": 503, \"headers\": {\"content-type\": \"text/plain\", \"cache-control\": \"no-store\"},\n            \"body\": \"GuardOath is being deployed. Try again in a few minutes.\"}\n"
    },
    "MemorySize": 512,
    "Timeout": 15,
    "ReservedConcurrentExecutions": 2,
    "Role": {
     "Fn::GetAtt": [
      "SiteRole",
      "Arn"
     ]
    },
    "LoggingConfig": {
     "LogGroup": {
      "Ref": "SiteLogGroup"
     }
    },
    "Environment": {
     "Variables": {
      "GUARDOATH_TENANT_STORE": "dynamodb",
      "GUARDOATH_TENANT_TABLE": {
       "Ref": "TenantTable"
      },
      "GUARDOATH_DEMO_KEY_SECRET": {
       "Ref": "DemoKeySecret"
      },
      "GUARDOATH_ENABLE_PII": "1",
      "GUARDOATH_ENABLE_AZURE_PROMPT_SHIELDS": "0",
      "GUARDOATH_CONTENT_SAFETY_PROVIDER": "none"
     }
    }
   }
  },
  "SiteUrl": {
   "Type": "AWS::Lambda::Url",
   "Properties": {
    "TargetFunctionArn": {
     "Fn::GetAtt": [
      "SiteFunction",
      "Arn"
     ]
    },
    "AuthType": "AWS_IAM",
    "InvokeMode": "BUFFERED"
   }
  },
  "CloudFrontInvokeUrl": {
   "Type": "AWS::Lambda::Permission",
   "Properties": {
    "FunctionName": {
     "Ref": "SiteFunction"
    },
    "Action": "lambda:InvokeFunctionUrl",
    "Principal": "cloudfront.amazonaws.com",
    "FunctionUrlAuthType": "AWS_IAM",
    "SourceArn": {
     "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
    }
   }
  },
  "CloudFrontInvokeFunction": {
   "Type": "AWS::Lambda::Permission",
   "Properties": {
    "FunctionName": {
     "Ref": "SiteFunction"
    },
    "Action": "lambda:InvokeFunction",
    "Principal": "cloudfront.amazonaws.com",
    "SourceArn": {
     "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
    }
   }
  },
  "OriginAccess": {
   "Type": "AWS::CloudFront::OriginAccessControl",
   "Properties": {
    "OriginAccessControlConfig": {
     "Name": "guardoath-site",
     "Description": "CloudFront signs every request to the GuardOath function URL",
     "OriginAccessControlOriginType": "lambda",
     "SigningBehavior": "always",
     "SigningProtocol": "sigv4"
    }
   }
  },
  "Certificate": {
   "Type": "AWS::CertificateManager::Certificate",
   "Properties": {
    "DomainName": {
     "Ref": "DomainName"
    },
    "SubjectAlternativeNames": [
     {
      "Fn::Sub": "www.${DomainName}"
     }
    ],
    "ValidationMethod": "DNS",
    "DomainValidationOptions": [
     {
      "DomainName": {
       "Ref": "DomainName"
      },
      "HostedZoneId": {
       "Ref": "HostedZoneId"
      }
     },
     {
      "DomainName": {
       "Fn::Sub": "www.${DomainName}"
      },
      "HostedZoneId": {
       "Ref": "HostedZoneId"
      }
     }
    ]
   }
  },
  "WebAcl": {
   "Type": "AWS::WAFv2::WebACL",
   "Properties": {
    "Name": "guardoath-site",
    "Scope": "CLOUDFRONT",
    "DefaultAction": {
     "Allow": {}
    },
    "VisibilityConfig": {
     "SampledRequestsEnabled": false,
     "CloudWatchMetricsEnabled": false,
     "MetricName": "guardoathSite"
    },
    "Rules": [
     {
      "Name": "RequestsPerIp",
      "Priority": 0,
      "Action": {
       "Block": {}
      },
      "Statement": {
       "RateBasedStatement": {
        "Limit": {
         "Ref": "RequestsPerIpPer5Minutes"
        },
        "EvaluationWindowSec": 300,
        "AggregateKeyType": "IP"
       }
      },
      "VisibilityConfig": {
       "SampledRequestsEnabled": false,
       "CloudWatchMetricsEnabled": false,
       "MetricName": "guardoathRequestsPerIp"
      }
     }
    ]
   }
  },
  "Distribution": {
   "Type": "AWS::CloudFront::Distribution",
   "Properties": {
    "DistributionConfig": {
     "Comment": "GuardOath website",
     "Enabled": true,
     "HttpVersion": "http2and3",
     "IPV6Enabled": true,
     "Aliases": [
      {
       "Ref": "DomainName"
      },
      {
       "Fn::Sub": "www.${DomainName}"
      }
     ],
     "ViewerCertificate": {
      "AcmCertificateArn": {
       "Ref": "Certificate"
      },
      "SslSupportMethod": "sni-only",
      "MinimumProtocolVersion": "TLSv1.2_2021"
     },
     "WebACLId": {
      "Fn::GetAtt": [
       "WebAcl",
       "Arn"
      ]
     },
     "Origins": [
      {
       "Id": "site",
       "DomainName": {
        "Fn::Select": [
         2,
         {
          "Fn::Split": [
           "/",
           {
            "Fn::GetAtt": [
             "SiteUrl",
             "FunctionUrl"
            ]
           }
          ]
         }
        ]
       },
       "OriginAccessControlId": {
        "Fn::GetAtt": [
         "OriginAccess",
         "Id"
        ]
       },
       "CustomOriginConfig": {
        "OriginProtocolPolicy": "https-only",
        "HTTPSPort": 443,
        "OriginSSLProtocols": [
         "TLSv1.2"
        ]
       }
      }
     ],
     "DefaultCacheBehavior": {
      "TargetOriginId": "site",
      "ViewerProtocolPolicy": "redirect-to-https",
      "Compress": true,
      "AllowedMethods": [
       "GET",
       "HEAD",
       "OPTIONS",
       "PUT",
       "PATCH",
       "POST",
       "DELETE"
      ],
      "CachedMethods": [
       "GET",
       "HEAD"
      ],
      "CachePolicyId": "4135ea2d-6df8-44a3-9df4-4b5a84be39ad",
      "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac"
     },
     "CacheBehaviors": [
      {
       "PathPattern": "/assets/*",
       "TargetOriginId": "site",
       "ViewerProtocolPolicy": "redirect-to-https",
       "Compress": true,
       "AllowedMethods": [
        "GET",
        "HEAD"
       ],
       "CachedMethods": [
        "GET",
        "HEAD"
       ],
       "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6"
      }
     ]
    }
   }
  },
  "ApexIpv4": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Ref": "DomainName"
    },
    "Type": "A",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "Distribution",
       "DomainName"
      ]
     },
     "HostedZoneId": "Z2FDTNDATAQYW2",
     "EvaluateTargetHealth": false
    }
   }
  },
  "ApexIpv6": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Ref": "DomainName"
    },
    "Type": "AAAA",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "Distribution",
       "DomainName"
      ]
     },
     "HostedZoneId": "Z2FDTNDATAQYW2",
     "EvaluateTargetHealth": false
    }
   }
  },
  "WwwIpv4": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Fn::Sub": "www.${DomainName}"
    },
    "Type": "A",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "Distribution",
       "DomainName"
      ]
     },
     "HostedZoneId": "Z2FDTNDATAQYW2",
     "EvaluateTargetHealth": false
    }
   }
  },
  "WwwIpv6": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Fn::Sub": "www.${DomainName}"
    },
    "Type": "AAAA",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "Distribution",
       "DomainName"
      ]
     },
     "HostedZoneId": "Z2FDTNDATAQYW2",
     "EvaluateTargetHealth": false
    }
   }
  },
  "FreePlan": {
   "Type": "AWS::PricingPlanManager::Subscription",
   "Properties": {
    "PlanFamily": "CloudFront",
    "PlanTier": "FREE",
    "UsageLevel": "DEFAULT",
    "ResourceArns": [
     {
      "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
     },
     {
      "Fn::GetAtt": [
       "WebAcl",
       "Arn"
      ]
     },
     {
      "Fn::Sub": "arn:${AWS::Partition}:route53:::hostedzone/${HostedZoneId}"
     }
    ]
   }
  },
  "ShutoffRole": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "lambda.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "shutoff",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": {
          "Fn::Sub": "${ShutoffLogGroup.Arn}"
         }
        },
        {
         "Effect": "Allow",
         "Action": "lambda:PutFunctionConcurrency",
         "Resource": {
          "Fn::GetAtt": [
           "SiteFunction",
           "Arn"
          ]
         }
        }
       ]
      }
     }
    ]
   }
  },
  "ShutoffFunction": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "FunctionName": "guardoath-site-shutoff",
    "Description": "Stops guardoath-site when a cost alarm fires",
    "Runtime": "python3.13",
    "Architectures": [
     "x86_64"
    ],
    "Handler": "index.handler",
    "Code": {
     "ZipFile": "import os\nimport boto3\ndef handler(event, context):\n    # Invoked by the cost alarms. Stops the site by setting its reserved concurrency to 0.\n    state = (event.get(\"alarmData\") or {}).get(\"state\", {}).get(\"value\")\n    if state != \"ALARM\":\n        return {\"changed\": False, \"state\": state}\n    boto3.client(\"lambda\").put_function_concurrency(FunctionName=os.environ[\"SITE_FUNCTION\"], ReservedConcurrentExecutions=0)\n    print(\"Site stopped by alarm\", (event.get(\"alarmData\") or {}).get(\"alarmName\"))\n    return {\"changed\": True}\n"
    },
    "MemorySize": 128,
    "Timeout": 10,
    "Role": {
     "Fn::GetAtt": [
      "ShutoffRole",
      "Arn"
     ]
    },
    "LoggingConfig": {
     "LogGroup": {
      "Ref": "ShutoffLogGroup"
     }
    },
    "Environment": {
     "Variables": {
      "SITE_FUNCTION": {
       "Ref": "SiteFunction"
      }
     }
    }
   }
  },
  "AlarmsInvokeShutoff": {
   "Type": "AWS::Lambda::Permission",
   "Properties": {
    "FunctionName": {
     "Ref": "ShutoffFunction"
    },
    "Action": "lambda:InvokeFunction",
    "Principal": "lambda.alarms.cloudwatch.amazonaws.com",
    "SourceAccount": {
     "Ref": "AWS::AccountId"
    },
    "SourceArn": {
     "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:guardoath-site-*"
    }
   }
  },
  "InvocationsPerHourAlarm": {
   "Type": "AWS::CloudWatch::Alarm",
   "Properties": {
    "AlarmName": "guardoath-site-invocations-per-hour",
    "AlarmDescription": "Stops the site: too many invocations in one hour for the free monthly allowance.",
    "Namespace": "AWS/Lambda",
    "MetricName": "Invocations",
    "Dimensions": [
     {
      "Name": "FunctionName",
      "Value": {
       "Ref": "SiteFunction"
      }
     }
    ],
    "Statistic": "Sum",
    "Period": 3600,
    "EvaluationPeriods": 1,
    "Threshold": {
     "Ref": "InvocationsPerHourLimit"
    },
    "ComparisonOperator": "GreaterThanThreshold",
    "TreatMissingData": "notBreaching",
    "AlarmActions": [
     {
      "Fn::GetAtt": [
       "ShutoffFunction",
       "Arn"
      ]
     }
    ]
   }
  },
  "InvocationsPerDayAlarm": {
   "Type": "AWS::CloudWatch::Alarm",
   "Properties": {
    "AlarmName": "guardoath-site-invocations-per-day",
    "AlarmDescription": "Stops the site: too many invocations in one day for the free monthly allowance.",
    "Namespace": "AWS/Lambda",
    "MetricName": "Invocations",
    "Dimensions": [
     {
      "Name": "FunctionName",
      "Value": {
       "Ref": "SiteFunction"
      }
     }
    ],
    "Statistic": "Sum",
    "Period": 86400,
    "EvaluationPeriods": 1,
    "Threshold": {
     "Ref": "InvocationsPerDayLimit"
    },
    "ComparisonOperator": "GreaterThanThreshold",
    "TreatMissingData": "notBreaching",
    "AlarmActions": [
     {
      "Fn::GetAtt": [
       "ShutoffFunction",
       "Arn"
      ]
     }
    ]
   }
  },
  "DurationPerHourAlarm": {
   "Type": "AWS::CloudWatch::Alarm",
   "Properties": {
    "AlarmName": "guardoath-site-duration-per-hour",
    "AlarmDescription": "Stops the site: too much run time in one hour for the free monthly compute allowance.",
    "Namespace": "AWS/Lambda",
    "MetricName": "Duration",
    "Dimensions": [
     {
      "Name": "FunctionName",
      "Value": {
       "Ref": "SiteFunction"
      }
     }
    ],
    "Statistic": "Sum",
    "Period": 3600,
    "EvaluationPeriods": 1,
    "Threshold": {
     "Ref": "DurationMsPerHourLimit"
    },
    "ComparisonOperator": "GreaterThanThreshold",
    "TreatMissingData": "notBreaching",
    "AlarmActions": [
     {
      "Fn::GetAtt": [
       "ShutoffFunction",
       "Arn"
      ]
     }
    ]
   }
  }
 },
 "Outputs": {
  "SiteAddress": {
   "Value": {
    "Fn::Sub": "https://${DomainName}/"
   }
  },
  "DistributionId": {
   "Value": {
    "Ref": "Distribution"
   }
  },
  "DistributionDomain": {
   "Value": {
    "Fn::GetAtt": [
     "Distribution",
     "DomainName"
    ]
   }
  },
  "FunctionName": {
   "Value": {
    "Ref": "SiteFunction"
   }
  },
  "FunctionUrl": {
   "Value": {
    "Fn::GetAtt": [
     "SiteUrl",
     "FunctionUrl"
    ]
   }
  },
  "TableName": {
   "Value": {
    "Ref": "TenantTable"
   }
  },
  "FreePlanStatus": {
   "Value": {
    "Fn::GetAtt": [
     "FreePlan",
     "Status"
    ]
   }
  }
 }
}
