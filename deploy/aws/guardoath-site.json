{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Description": "GuardOath website (guardoath.com): CloudFront flat-rate Free plan + WAF rate rule + Lambda function URL (origin access control) + DynamoDB tenant records, with alarms that stop the site before the free allowances run out. See deploy/aws/README.md.",
 "Parameters": {
  "DomainName": {
   "Type": "String",
   "Default": "guardoath.com",
   "AllowedPattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
  },
  "HostedZoneId": {
   "Type": "String",
   "Default": "Z0746804K5NUDOB3FWPU",
   "AllowedPattern": "^Z[A-Z0-9]{1,32}$"
  },
  "DemoKeySecret": {
   "Type": "String",
   "NoEcho": true,
   "MinLength": 32,
   "MaxLength": 200,
   "Description": "Secret the demo user keys are derived from (GUARDOATH_DEMO_KEY_SECRET). At least 32 characters."
  },
  "SiteConcurrency": {
   "Type": "Number",
   "Default": 5,
   "MinValue": 1,
   "MaxValue": 10,
   "Description": "How many requests the site function runs at the same time. One page load sends up to 5 at once (page, script, styles, logo, demo users); requests over the limit are refused by Lambda and the dashboard retries them. Raising it does not change prices; the shutoff alarms limit total use."
  },
  "TableReadCapacity": {
   "Type": "Number",
   "Default": 10,
   "MinValue": 1,
   "MaxValue": 25,
   "Description": "Provisioned reads. The always-free DynamoDB allowance is 25 read capacity units in total."
  },
  "TableWriteCapacity": {
   "Type": "Number",
   "Default": 10,
   "MinValue": 1,
   "MaxValue": 25,
   "Description": "Provisioned writes. The always-free DynamoDB allowance is 25 write capacity units in total."
  },
  "RequestsPerIpPer5Minutes": {
   "Type": "Number",
   "Default": 300,
   "MinValue": 10,
   "MaxValue": 20000
  },
  "InvocationsPerDayLimit": {
   "Type": "Number",
   "Default": 30000,
   "Description": "Stop the site above this many invocations in any 24 hours (30,000 x 31 days = 930,000 < the 1,000,000 free requests a month). Evaluated every minute."
  },
  "DurationMsPerDayLimit": {
   "Type": "Number",
   "Default": 24000000,
   "Description": "Stop the site above this much function run time (ms) in any 24 hours. 24,000 s x 0.5 GB x 31 days = 372,000 GB-seconds < the 400,000 free GB-seconds a month. Evaluated every minute."
  },
  "SignInDomainPrefix": {
   "Type": "String",
   "Default": "guardoath-sign-in",
   "AllowedPattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
   "Description": "Prefix of the tenant sign-in page: <prefix>.auth.<region>.amazoncognito.com. Must be unused in the region."
  },
  "EnableGoogleLogin": {
   "Type": "String",
   "Default": "0",
   "AllowedValues": [
    "0",
    "1"
   ],
   "Description": "Explicitly opt in to the Google OAuth provider after verifying credentials and reviewing Cognito costs."
  },
  "GoogleOAuthClientId": {
   "Type": "String",
   "Default": "",
   "AllowedPattern": "^$|^[0-9A-Za-z_.-]+\\.apps\\.googleusercontent\\.com$",
   "Description": "Google OAuth Web Application client ID; only used when EnableGoogleLogin=1."
  },
  "GoogleOAuthClientSecret": {
   "Type": "String",
   "Default": "",
   "NoEcho": true,
   "MaxLength": 256,
   "Description": "Google OAuth Web Application client secret. Supply securely as a NoEcho stack parameter; never commit to source or Lambda environment."
  },
  "EnableSelfRegistration": {
   "Type": "String",
   "Default": "0",
   "AllowedValues": [
    "0",
    "1"
   ],
   "Description": "Opt-in customer registration after verified Google OAuth configuration; registration never grants a paid entitlement."
  }
 },
 "Rules": {
  "UsEast1Only": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Equals": [
       {
        "Ref": "AWS::Region"
       },
       "us-east-1"
      ]
     },
     "AssertDescription": "Deploy in us-east-1: the CloudFront certificate and the CLOUDFRONT-scope web ACL must be there."
    }
   ]
  },
  "GoogleConfiguration": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Or": [
       {
        "Fn::Equals": [
         {
          "Ref": "EnableGoogleLogin"
         },
         "0"
        ]
       },
       {
        "Fn::And": [
         {
          "Fn::Not": [
           {
            "Fn::Equals": [
             {
              "Ref": "GoogleOAuthClientId"
             },
             ""
            ]
           }
          ]
         },
         {
          "Fn::Not": [
           {
            "Fn::Equals": [
             {
              "Ref": "GoogleOAuthClientSecret"
             },
             ""
            ]
           }
          ]
         }
        ]
       }
      ]
     },
     "AssertDescription": "Google login needs a Google OAuth Web Application client ID and nonempty private secret when enabled."
    },
    {
     "Assert": {
      "Fn::Or": [
       {
        "Fn::Equals": [
         {
          "Ref": "EnableSelfRegistration"
         },
         "0"
        ]
       },
       {
        "Fn::Equals": [
         {
          "Ref": "EnableGoogleLogin"
         },
         "1"
        ]
       }
      ]
     },
     "AssertDescription": "Public self-registration requires Google login to be enabled."
    }
   ]
  }
 },
 "Resources": {
  "TenantTable": {
   "Type": "AWS::DynamoDB::Table",
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain",
   "Properties": {
    "TableName": "guardoath-tenants",
    "BillingMode": "PROVISIONED",
    "AttributeDefinitions": [
     {
      "AttributeName": "tenant_id",
      "AttributeType": "S"
     }
    ],
    "KeySchema": [
     {
      "AttributeName": "tenant_id",
      "KeyType": "HASH"
     }
    ],
    "ProvisionedThroughput": {
     "ReadCapacityUnits": {
      "Ref": "TableReadCapacity"
     },
     "WriteCapacityUnits": {
      "Ref": "TableWriteCapacity"
     }
    },
    "DeletionProtectionEnabled": true
   }
  },
  "SiteLogGroup": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": "/aws/lambda/guardoath-site",
    "RetentionInDays": 7
   }
  },
  "ShutoffLogGroup": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": "/aws/lambda/guardoath-site-shutoff",
    "RetentionInDays": 7
   }
  },
  "SiteRole": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "lambda.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "site",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": {
          "Fn::Sub": "${SiteLogGroup.Arn}"
         }
        },
        {
         "Effect": "Allow",
         "Action": [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:Scan"
         ],
         "Resource": {
          "Fn::GetAtt": [
           "TenantTable",
           "Arn"
          ]
         }
        }
       ]
      }
     }
    ]
   }
  },
  "SiteFunction": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "FunctionName": "guardoath-site",
    "Description": "GuardOath website and API",
    "Runtime": "python3.13",
    "Architectures": [
     "x86_64"
    ],
    "Handler": "index.handler",
    "Code": {
     "ZipFile": "import json\ndef handler(event, context):\n    # Replaced by the real package: aws lambda update-function-code (see deploy/aws/README.md).\n    return {\"statusCode\": 503, \"headers\": {\"content-type\": \"text/plain\", \"cache-control\": \"no-store\"},\n            \"body\": \"GuardOath is being deployed. Try again in a few minutes.\"}\n"
    },
    "MemorySize": 512,
    "Timeout": 15,
    "ReservedConcurrentExecutions": {
     "Ref": "SiteConcurrency"
    },
    "Role": {
     "Fn::GetAtt": [
      "SiteRole",
      "Arn"
     ]
    },
    "LoggingConfig": {
     "LogGroup": {
      "Ref": "SiteLogGroup"
     }
    },
    "Environment": {
     "Variables": {
      "GUARDOATH_TENANT_STORE": "dynamodb",
      "GUARDOATH_TENANT_TABLE": {
       "Ref": "TenantTable"
      },
      "GUARDOATH_DEMO_KEY_SECRET": {
       "Ref": "DemoKeySecret"
      },
      "GUARDOATH_ENABLE_PII": "1",
      "GUARDOATH_COGNITO_POOL_ID": {
       "Ref": "UserPool"
      },
      "GUARDOATH_COGNITO_CLIENT_ID": {
       "Ref": "UserPoolClient"
      },
      "GUARDOATH_COGNITO_DOMAIN": {
       "Fn::Sub": "${SignInDomainPrefix}.auth.${AWS::Region}.amazoncognito.com"
      },
      "GUARDOATH_COGNITO_REDIRECT_URI": {
       "Fn::Sub": "https://${DomainName}/dashboard"
      },
      "GUARDOATH_SELF_REGISTRATION": {
       "Ref": "EnableSelfRegistration"
      },
      "GUARDOATH_GOOGLE_LOGIN_ENABLED": {
       "Ref": "EnableGoogleLogin"
      }
     }
    }
   }
  },
  "SiteUrl": {
   "Type": "AWS::Lambda::Url",
   "Properties": {
    "TargetFunctionArn": {
     "Fn::GetAtt": [
      "SiteFunction",
      "Arn"
     ]
    },
    "AuthType": "AWS_IAM",
    "InvokeMode": "BUFFERED"
   }
  },
  "CloudFrontInvokeUrl": {
   "Type": "AWS::Lambda::Permission",
   "Properties": {
    "FunctionName": {
     "Ref": "SiteFunction"
    },
    "Action": "lambda:InvokeFunctionUrl",
    "Principal": "cloudfront.amazonaws.com",
    "FunctionUrlAuthType": "AWS_IAM",
    "SourceArn": {
     "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
    }
   }
  },
  "CloudFrontInvokeFunction": {
   "Type": "AWS::Lambda::Permission",
   "Properties": {
    "FunctionName": {
     "Ref": "SiteFunction"
    },
    "Action": "lambda:InvokeFunction",
    "Principal": "cloudfront.amazonaws.com",
    "SourceArn": {
     "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
    }
   }
  },
  "OriginAccess": {
   "Type": "AWS::CloudFront::OriginAccessControl",
   "Properties": {
    "OriginAccessControlConfig": {
     "Name": "guardoath-site",
     "Description": "CloudFront signs every request to the GuardOath function URL",
     "OriginAccessControlOriginType": "lambda",
     "SigningBehavior": "always",
     "SigningProtocol": "sigv4"
    }
   }
  },
  "Certificate": {
   "Type": "AWS::CertificateManager::Certificate",
   "Properties": {
    "DomainName": {
     "Ref": "DomainName"
    },
    "SubjectAlternativeNames": [
     {
      "Fn::Sub": "www.${DomainName}"
     }
    ],
    "ValidationMethod": "DNS",
    "DomainValidationOptions": [
     {
      "DomainName": {
       "Ref": "DomainName"
      },
      "HostedZoneId": {
       "Ref": "HostedZoneId"
      }
     },
     {
      "DomainName": {
       "Fn::Sub": "www.${DomainName}"
      },
      "HostedZoneId": {
       "Ref": "HostedZoneId"
      }
     }
    ]
   }
  },
  "WebAcl": {
   "Type": "AWS::WAFv2::WebACL",
   "Properties": {
    "Name": "guardoath-site",
    "Scope": "CLOUDFRONT",
    "DefaultAction": {
     "Allow": {}
    },
    "VisibilityConfig": {
     "SampledRequestsEnabled": false,
     "CloudWatchMetricsEnabled": false,
     "MetricName": "guardoathSite"
    },
    "Rules": [
     {
      "Name": "RequestsPerIp",
      "Priority": 0,
      "Action": {
       "Block": {}
      },
      "Statement": {
       "RateBasedStatement": {
        "Limit": {
         "Ref": "RequestsPerIpPer5Minutes"
        },
        "EvaluationWindowSec": 300,
        "AggregateKeyType": "IP"
       }
      },
      "VisibilityConfig": {
       "SampledRequestsEnabled": false,
       "CloudWatchMetricsEnabled": false,
       "MetricName": "guardoathRequestsPerIp"
      }
     }
    ]
   }
  },
  "Distribution": {
   "Type": "AWS::CloudFront::Distribution",
   "Properties": {
    "DistributionConfig": {
     "Comment": "GuardOath website",
     "Enabled": true,
     "HttpVersion": "http2and3",
     "IPV6Enabled": true,
     "Aliases": [
      {
       "Ref": "DomainName"
      },
      {
       "Fn::Sub": "www.${DomainName}"
      }
     ],
     "ViewerCertificate": {
      "AcmCertificateArn": {
       "Ref": "Certificate"
      },
      "SslSupportMethod": "sni-only",
      "MinimumProtocolVersion": "TLSv1.2_2021"
     },
     "WebACLId": {
      "Fn::GetAtt": [
       "WebAcl",
       "Arn"
      ]
     },
     "Origins": [
      {
       "Id": "site",
       "DomainName": {
        "Fn::Select": [
         2,
         {
          "Fn::Split": [
           "/",
           {
            "Fn::GetAtt": [
             "SiteUrl",
             "FunctionUrl"
            ]
           }
          ]
         }
        ]
       },
       "OriginAccessControlId": {
        "Fn::GetAtt": [
         "OriginAccess",
         "Id"
        ]
       },
       "CustomOriginConfig": {
        "OriginProtocolPolicy": "https-only",
        "HTTPSPort": 443,
        "OriginSSLProtocols": [
         "TLSv1.2"
        ]
       }
      }
     ],
     "DefaultCacheBehavior": {
      "TargetOriginId": "site",
      "ViewerProtocolPolicy": "redirect-to-https",
      "Compress": true,
      "AllowedMethods": [
       "GET",
       "HEAD",
       "OPTIONS",
       "PUT",
       "PATCH",
       "POST",
       "DELETE"
      ],
      "CachedMethods": [
       "GET",
       "HEAD"
      ],
      "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
      "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac"
     },
     "CacheBehaviors": [
      {
       "PathPattern": "/assets/*",
       "TargetOriginId": "site",
       "ViewerProtocolPolicy": "redirect-to-https",
       "Compress": true,
       "AllowedMethods": [
        "GET",
        "HEAD"
       ],
       "CachedMethods": [
        "GET",
        "HEAD"
       ],
       "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6"
      }
     ]
    }
   }
  },
  "ApexIpv4": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Ref": "DomainName"
    },
    "Type": "A",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "Distribution",
       "DomainName"
      ]
     },
     "HostedZoneId": "Z2FDTNDATAQYW2",
     "EvaluateTargetHealth": false
    }
   }
  },
  "ApexIpv6": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Ref": "DomainName"
    },
    "Type": "AAAA",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "Distribution",
       "DomainName"
      ]
     },
     "HostedZoneId": "Z2FDTNDATAQYW2",
     "EvaluateTargetHealth": false
    }
   }
  },
  "WwwIpv4": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Fn::Sub": "www.${DomainName}"
    },
    "Type": "A",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "Distribution",
       "DomainName"
      ]
     },
     "HostedZoneId": "Z2FDTNDATAQYW2",
     "EvaluateTargetHealth": false
    }
   }
  },
  "WwwIpv6": {
   "Type": "AWS::Route53::RecordSet",
   "Properties": {
    "HostedZoneId": {
     "Ref": "HostedZoneId"
    },
    "Name": {
     "Fn::Sub": "www.${DomainName}"
    },
    "Type": "AAAA",
    "AliasTarget": {
     "DNSName": {
      "Fn::GetAtt": [
       "Distribution",
       "DomainName"
      ]
     },
     "HostedZoneId": "Z2FDTNDATAQYW2",
     "EvaluateTargetHealth": false
    }
   }
  },
  "FreePlan": {
   "Type": "AWS::PricingPlanManager::Subscription",
   "Properties": {
    "PlanFamily": "CloudFront",
    "PlanTier": "FREE",
    "UsageLevel": "DEFAULT",
    "ResourceArns": [
     {
      "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
     },
     {
      "Fn::GetAtt": [
       "WebAcl",
       "Arn"
      ]
     },
     {
      "Fn::Sub": "arn:${AWS::Partition}:route53:::hostedzone/${HostedZoneId}"
     }
    ]
   }
  },
  "ShutoffRole": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "lambda.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "shutoff",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": {
          "Fn::Sub": "${ShutoffLogGroup.Arn}"
         }
        },
        {
         "Effect": "Allow",
         "Action": "lambda:PutFunctionConcurrency",
         "Resource": {
          "Fn::GetAtt": [
           "SiteFunction",
           "Arn"
          ]
         }
        }
       ]
      }
     }
    ]
   }
  },
  "ShutoffFunction": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "FunctionName": "guardoath-site-shutoff",
    "Description": "Stops guardoath-site when a cost alarm fires",
    "Runtime": "python3.13",
    "Architectures": [
     "x86_64"
    ],
    "Handler": "index.handler",
    "Code": {
     "ZipFile": "import os\nimport boto3\ndef handler(event, context):\n    # Invoked by the cost alarms. Stops the site by setting its reserved concurrency to 0.\n    state = (event.get(\"alarmData\") or {}).get(\"state\", {}).get(\"value\")\n    if state != \"ALARM\":\n        return {\"changed\": False, \"state\": state}\n    boto3.client(\"lambda\").put_function_concurrency(FunctionName=os.environ[\"SITE_FUNCTION\"], ReservedConcurrentExecutions=0)\n    print(\"Site stopped by alarm\", (event.get(\"alarmData\") or {}).get(\"alarmName\"))\n    return {\"changed\": True}\n"
    },
    "MemorySize": 128,
    "Timeout": 10,
    "Role": {
     "Fn::GetAtt": [
      "ShutoffRole",
      "Arn"
     ]
    },
    "LoggingConfig": {
     "LogGroup": {
      "Ref": "ShutoffLogGroup"
     }
    },
    "Environment": {
     "Variables": {
      "SITE_FUNCTION": {
       "Ref": "SiteFunction"
      }
     }
    }
   }
  },
  "AlarmsInvokeShutoff": {
   "Type": "AWS::Lambda::Permission",
   "Properties": {
    "FunctionName": {
     "Ref": "ShutoffFunction"
    },
    "Action": "lambda:InvokeFunction",
    "Principal": "lambda.alarms.cloudwatch.amazonaws.com",
    "SourceAccount": {
     "Ref": "AWS::AccountId"
    },
    "SourceArn": {
     "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:guardoath-site-*"
    }
   }
  },
  "InvocationsPerDayAlarm": {
   "Type": "AWS::CloudWatch::Alarm",
   "Properties": {
    "AlarmName": "guardoath-site-invocations-per-day",
    "AlarmDescription": "Stops the site: too many invocations in one day for the free monthly allowance.",
    "Namespace": "AWS/Lambda",
    "MetricName": "Invocations",
    "Dimensions": [
     {
      "Name": "FunctionName",
      "Value": {
       "Ref": "SiteFunction"
      }
     }
    ],
    "Statistic": "Sum",
    "Period": 86400,
    "EvaluationPeriods": 1,
    "Threshold": {
     "Ref": "InvocationsPerDayLimit"
    },
    "ComparisonOperator": "GreaterThanThreshold",
    "TreatMissingData": "notBreaching",
    "AlarmActions": [
     {
      "Fn::GetAtt": [
       "ShutoffFunction",
       "Arn"
      ]
     }
    ]
   }
  },
  "DurationPerDayAlarm": {
   "Type": "AWS::CloudWatch::Alarm",
   "Properties": {
    "AlarmName": "guardoath-site-duration-per-day",
    "AlarmDescription": "Stops the site: too much run time in 24 hours for the free monthly compute allowance.",
    "Namespace": "AWS/Lambda",
    "MetricName": "Duration",
    "Dimensions": [
     {
      "Name": "FunctionName",
      "Value": {
       "Ref": "SiteFunction"
      }
     }
    ],
    "Statistic": "Sum",
    "Period": 86400,
    "EvaluationPeriods": 1,
    "Threshold": {
     "Ref": "DurationMsPerDayLimit"
    },
    "ComparisonOperator": "GreaterThanThreshold",
    "TreatMissingData": "notBreaching",
    "AlarmActions": [
     {
      "Fn::GetAtt": [
       "ShutoffFunction",
       "Arn"
      ]
     }
    ]
   }
  },
  "UserPool": {
   "Type": "AWS::Cognito::UserPool",
   "DeletionPolicy": "Retain",
   "UpdateReplacePolicy": "Retain",
   "Properties": {
    "UserPoolName": "guardoath-tenants",
    "UserPoolTier": "LITE",
    "DeletionProtection": "ACTIVE",
    "UsernameAttributes": [
     "email"
    ],
    "AutoVerifiedAttributes": [
     "email"
    ],
    "AdminCreateUserConfig": {
     "AllowAdminCreateUserOnly": true
    },
    "MfaConfiguration": "ON",
    "EnabledMfas": [
     "SOFTWARE_TOKEN_MFA"
    ],
    "Policies": {
     "PasswordPolicy": {
      "MinimumLength": 12,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNumbers": true,
      "RequireSymbols": false,
      "TemporaryPasswordValidityDays": 7
     }
    },
    "AccountRecoverySetting": {
     "RecoveryMechanisms": [
      {
       "Name": "verified_email",
       "Priority": 1
      }
     ]
    },
    "EmailConfiguration": {
     "EmailSendingAccount": "COGNITO_DEFAULT"
    },
    "Schema": [
     {
      "Name": "tenant_id",
      "AttributeDataType": "String",
      "Mutable": false,
      "StringAttributeConstraints": {
       "MinLength": "2",
       "MaxLength": "40"
      }
     }
    ]
   }
  },
  "UserPoolDomain": {
   "Type": "AWS::Cognito::UserPoolDomain",
   "Properties": {
    "Domain": {
     "Ref": "SignInDomainPrefix"
    },
    "UserPoolId": {
     "Ref": "UserPool"
    },
    "ManagedLoginVersion": 1
   }
  },
  "UserPoolClient": {
   "Type": "AWS::Cognito::UserPoolClient",
   "Properties": {
    "UserPoolId": {
     "Ref": "UserPool"
    },
    "ClientName": "guardoath-dashboard",
    "GenerateSecret": false,
    "AllowedOAuthFlowsUserPoolClient": true,
    "AllowedOAuthFlows": [
     "code"
    ],
    "AllowedOAuthScopes": [
     "openid",
     "email",
     "aws.cognito.signin.user.admin"
    ],
    "CallbackURLs": [
     {
      "Fn::Sub": "https://${DomainName}/dashboard"
     }
    ],
    "LogoutURLs": [
     {
      "Fn::Sub": "https://${DomainName}/dashboard"
     }
    ],
    "SupportedIdentityProviders": {
     "Fn::If": [
      "GoogleLoginEnabled",
      [
       "COGNITO",
       {
        "Ref": "GoogleIdentityProvider"
       }
      ],
      [
       "COGNITO"
      ]
     ]
    },
    "ExplicitAuthFlows": [
     "ALLOW_REFRESH_TOKEN_AUTH"
    ],
    "PreventUserExistenceErrors": "ENABLED",
    "EnableTokenRevocation": true,
    "AccessTokenValidity": 60,
    "IdTokenValidity": 60,
    "RefreshTokenValidity": 1,
    "TokenValidityUnits": {
     "AccessToken": "minutes",
     "IdToken": "minutes",
     "RefreshToken": "days"
    },
    "ReadAttributes": [
     "email",
     "email_verified",
     "custom:tenant_id"
    ],
    "WriteAttributes": [
     "email"
    ]
   }
  },
  "GoogleIdentityProvider": {
   "Type": "AWS::Cognito::UserPoolIdentityProvider",
   "Condition": "GoogleLoginEnabled",
   "Properties": {
    "UserPoolId": {
     "Ref": "UserPool"
    },
    "ProviderName": "Google",
    "ProviderType": "Google",
    "ProviderDetails": {
     "client_id": {
      "Ref": "GoogleOAuthClientId"
     },
     "client_secret": {
      "Ref": "GoogleOAuthClientSecret"
     },
     "authorize_scopes": "email profile openid"
    },
    "AttributeMapping": {
     "email": "email",
     "email_verified": "email_verified"
    }
   }
  }
 },
 "Outputs": {
  "SiteAddress": {
   "Value": {
    "Fn::Sub": "https://${DomainName}/"
   }
  },
  "DistributionId": {
   "Value": {
    "Ref": "Distribution"
   }
  },
  "DistributionDomain": {
   "Value": {
    "Fn::GetAtt": [
     "Distribution",
     "DomainName"
    ]
   }
  },
  "FunctionName": {
   "Value": {
    "Ref": "SiteFunction"
   }
  },
  "FunctionUrl": {
   "Value": {
    "Fn::GetAtt": [
     "SiteUrl",
     "FunctionUrl"
    ]
   }
  },
  "TableName": {
   "Value": {
    "Ref": "TenantTable"
   }
  },
  "FreePlanStatus": {
   "Value": {
    "Fn::GetAtt": [
     "FreePlan",
     "Status"
    ]
   }
  },
  "UserPoolId": {
   "Value": {
    "Ref": "UserPool"
   }
  },
  "SignInDomain": {
   "Value": {
    "Fn::Sub": "${SignInDomainPrefix}.auth.${AWS::Region}.amazoncognito.com"
   }
  },
  "GoogleLoginConfigured": {
   "Value": {
    "Fn::If": [
     "GoogleLoginEnabled",
     "true",
     "false"
    ]
   }
  },
  "SelfRegistrationConfigured": {
   "Value": {
    "Ref": "EnableSelfRegistration"
   }
  },
  "UserPoolClientId": {
   "Value": {
    "Ref": "UserPoolClient"
   }
  }
 },
 "Conditions": {
  "GoogleLoginEnabled": {
   "Fn::Equals": [
    {
     "Ref": "EnableGoogleLogin"
    },
    "1"
   ]
  }
 }
}
